; Maximum-width layout. PUSH widths and program counters shrink when values need fewer bytes.
    0x0: CODESIZE
    0x1: RETURNDATASIZE
    0x2: RETURNDATASIZE
    0x3: CODECOPY
    0x4: PUSH2     deploymentLength
    0x7: PUSH1     0x2d
    0x9: RETURNDATASIZE
    0xa: CREATE
    0xb: RETURNDATASIZE
    0xc: RETURNDATASIZE
    0xd: RETURNDATASIZE
    0xe: PUSH2     callLength
   0x11: PUSH2     callDataOffset
   0x14: CALLVALUE
   0x15: DUP7
   0x16: PUSH8     flashCallGasLimit
   0x1f: CALL
   0x20: DUP2
   0x21: MSTORE8
   0x22: RETURNDATASIZE
   0x23: DUP2
   0x24: PUSH1     0x1
   0x26: RETURNDATACOPY
   0x27: RETURNDATASIZE
   0x28: PUSH1     0x1
   0x2a: ADD
   0x2b: DUP2
   0x2c: RETURN
