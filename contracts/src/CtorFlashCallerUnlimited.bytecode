    0x9: RETURNDATASIZE
    0xa: CREATE
    0xb: RETURNDATASIZE
    0xc: RETURNDATASIZE
    0xd: RETURNDATASIZE
    0xe: PUSH2     callLength
   0x11: PUSH2     callDataOffset
   0x14: CALLVALUE
   0x15: DUP7
   0x16: GAS
   0x17: CALL
   0x18: DUP2
   0x19: MSTORE8
   0x1a: RETURNDATASIZE
   0x1b: DUP2
   0x1c: PUSH1     0x1
   0x1e: RETURNDATACOPY
   0x1f: RETURNDATASIZE
