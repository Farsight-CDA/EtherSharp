using EtherSharp.Types;

namespace EtherSharp.Common.Extensions;

/// <summary>
/// Provides fixed-size byte search helpers for read-only byte spans.
/// </summary>
public static class ReadOnlySpanExtensions
{
    extension(ReadOnlySpan<byte> span)
    {
<#
for(var i = 1; i <= 32; i++)
{
#>
        /// <summary>
        /// Determines whether <paramref name="span"/> contains <paramref name="value"/>.
        /// </summary>
        /// <param name="value">The fixed-size byte sequence to find.</param>
        /// <returns>True when <paramref name="value"/> occurs in <paramref name="span"/>; otherwise false.</returns>
        public bool Contains(in Bytes<#= i #> value)
            => span.IndexOf(value.DangerousGetReadOnlySpan()) >= 0;

        /// <summary>
        /// Finds the first occurrence of <paramref name="value"/> in <paramref name="span"/>.
        /// </summary>
        /// <param name="value">The fixed-size byte sequence to find.</param>
        /// <returns>The zero-based index of <paramref name="value"/>, or -1 when it is not found.</returns>
        public int IndexOf(in Bytes<#= i #> value)
            => span.IndexOf(value.DangerousGetReadOnlySpan());

<#
}
#>
        /// <summary>
        /// Determines whether <paramref name="span"/> contains <paramref name="value"/>.
        /// </summary>
        /// <param name="value">The address byte sequence to find.</param>
        /// <returns>True when <paramref name="value"/> occurs in <paramref name="span"/>; otherwise false.</returns>
        public bool Contains(in Address value)
            => span.IndexOf(value.DangerousGetReadOnlySpan()) >= 0;

        /// <summary>
        /// Finds the first occurrence of <paramref name="value"/> in <paramref name="span"/>.
        /// </summary>
        /// <param name="value">The address byte sequence to find.</param>
        /// <returns>The zero-based index of <paramref name="value"/>, or -1 when it is not found.</returns>
        public int IndexOf(in Address value)
            => span.IndexOf(value.DangerousGetReadOnlySpan());
