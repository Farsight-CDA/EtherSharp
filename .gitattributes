# Normalize text files in repo as LF.
* text=auto eol=lf

# Keep Windows-native script files as CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Use -text for binaries to skip line-ending normalization and the UTF-8 check.
*.png -text
*.jpg -text
*.jpeg -text
*.gif -text
*.pdf -text
*.zip -text
*.dll -text
*.exe -text
